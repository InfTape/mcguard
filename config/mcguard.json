{
  "$schema": "./mcguard.schema.json",
  "version": "1.0.0",
  "network": {
    "default_policy": "BLOCK",
    "allow_localhost": true,
    "allow_dns": true,
    "allowed_domain_suffixes": [
      "mojang.com",
      "minecraft.net",
      "minecraftservices.com",
      "minecraft-services.net",
      "3c3u.org"
    ],
    "whitelist": [
      {
        "description": "Default Minecraft Local Server",
        "ip": "127.0.0.1",
        "port": 25565,
        "protocol": "TCP"
      },
      {
        "description": "LAN Private Subnet (192.168.0.0/16)",
        "ip": "192.168.0.0/16",
        "port": 0,
        "protocol": "ANY"
      },
      {
        "description": "LAN Private Subnet (10.0.0.0/8)",
        "ip": "10.0.0.0/8",
        "port": 0,
        "protocol": "ANY"
      },
      {
        "description": "LAN Private Subnet (172.16.0.0/12)",
        "ip": "172.16.0.0/12",
        "port": 0,
        "protocol": "ANY"
      },
      {
        "description": "3c3u Minecraft Server",
        "host": "3c3u.org",
        "ip": "202.189.7.174",
        "port": 25565,
        "protocol": "TCP"
      }
    ]
  },
  "file_audit": {
    "enabled": true,
    "highlight_sensitive": true,
    "auto_whitelist_game_dir": true,
    "allowed_folders": [],
    "sensitive_patterns": [
      ".ssh",
      "id_rsa",
      "launcher_profiles.json",
      "servers.dat",
      "usercache.json",
      "Cookies",
      "Login Data",
      "Local State",
      "tokens.json",
      "user-account-private-data.json",
      "mcguard_desktop_test"
    ]
  },
  "logging": {
    "jsonl_output": "mcguard_audit.jsonl",
    "console_output": true,
    "verbose": false,
    "auto_close_on_exit": false,
    "auto_close_delay": 5
  },
  "sandbox": {
    "enabled": true,
    "block_child_processes": true,
    "use_job_object": true,
    "real_java_path": ""
  },
  "appcontainer": {
    "enabled": true,
    "profile_name": "MCGuard.Sandbox",
    "allowed_hkcu_keys": [
      "Software\\JavaSoft"
    ],
    "enable_broker": true,
    "broker_allowed_keys": [
      "Software\\JavaSoft",
      "Environment"
    ]
  }
}
