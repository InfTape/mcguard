{
  "$schema": "./mcguard.schema.json",
  "version": "1.0.0",
  "network": {
    "default_policy": "BLOCK",
    "allow_localhost": true,
    "allow_dns": true,
    "allow_mojang_auth": false,
    "whitelist": [
      {
        "description": "Default Minecraft Local Server",
        "ip": "127.0.0.1",
        "port": 25565,
        "protocol": "TCP"
      },
      {
        "description": "Example Target Server",
        "ip": "1.2.3.4",
        "port": 25565,
        "protocol": "TCP"
      }
    ]
  },
  "file_audit": {
    "enabled": true,
    "highlight_sensitive": true,
    "sensitive_patterns": [
      ".ssh",
      "id_rsa",
      "launcher_profiles.json",
      "servers.dat",
      "usercache.json",
      "Cookies",
      "Login Data",
      "Local State",
      "tokens.json"
    ]
  },
  "ipc": {
    "pipe_name": "\\\\.\\pipe\\mcguard_ipc"
  },
  "logging": {
    "jsonl_output": "mcguard_audit.jsonl",
    "console_output": true,
    "verbose": false
  }
}
